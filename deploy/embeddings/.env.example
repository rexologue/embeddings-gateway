# Copy this file to .env and replace values for your host.
#
# vLLM settings (pooling, memory, batching, served model name) are not here:
# they live in serve_embeddings.sh, a copy of serve_embeddings.example.sh.

#############################
# Engine API                #
#############################

# Host address and port of the engine API. The gateway (deploy/gateway)
# reaches it through the host, GATEWAY_BACKEND_BASE_URL=
# http://host.docker.gateway:<EMBEDDINGS_HTTP_PORT>, so the port must be
# published on an address the gateway container can reach: 127.0.0.1 is not
# one of them. 172.17.0.1 (docker0, what host.docker.gateway resolves to)
# reaches containers only; 0.0.0.0 also exposes it to the network.
EMBEDDINGS_HOST=0.0.0.0
EMBEDDINGS_HTTP_PORT=11010

# Engine API key, passed to vLLM as --api-key through serve_embeddings.sh.
# Put the same value into GATEWAY_BACKEND_API_KEY of deploy/gateway: the
# gateway then adds it to every request and clients never see it. Empty = no
# key. vLLM checks it only under /v1: /tokenize, /health and /metrics stay
# open, so a published engine port is still worth a firewall.
EMBEDDINGS_API_KEY=

#############################
# Engine (vLLM)             #
#############################

EMBEDDINGS_VLLM_IMAGE=vllm/vllm-openai:v0.30.0
EMBEDDINGS_CONTAINER_NAME=embeddings-vllm

# Model weights on the host, mounted read-only at /model (MODEL_NAME in
# serve_embeddings.sh).
EMBEDDINGS_MODEL_PATH=/path/to/Qwen3-Embedding-0.6B

# Host GPUs the engine sees (NVIDIA_VISIBLE_DEVICES): "0", "0,1" or "all".
# On a GPU shared with an LLM, keep the sum of GPU_MEMORY_UTILIZATION of all
# engines on it below ~0.95.
EMBEDDINGS_GPU_DEVICES=0

#############################
# Engine metrics            #
#############################

# Prometheus scraping vLLM /metrics over the compose network.
EMBEDDINGS_PROMETHEUS_IMAGE=prom/prometheus:latest
EMBEDDINGS_PROMETHEUS_CONTAINER_NAME=embeddings-vllm-prometheus
EMBEDDINGS_PROMETHEUS_HTTP_PORT=11101
