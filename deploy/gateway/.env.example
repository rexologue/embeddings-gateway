# Copy this file to .env and adjust values for the host.

GATEWAY_HOST=0.0.0.0
GATEWAY_HTTP_PORT=11000
GATEWAY_PROMETHEUS_HTTP_PORT=11100
GATEWAY_LOKI_HTTP_PORT=11102

GATEWAY_CONTAINER_NAME=embeddings-gateway
GATEWAY_BACKEND_BASE_URL=http://host.docker.gateway:11010

# Engine key: EMBEDDINGS_API_KEY of deploy/embeddings, the same value. The
# gateway sends it on every proxied request and drops the caller's
# Authorization, so callers never need it. Empty = the caller's headers are
# passed through as they are.
GATEWAY_BACKEND_API_KEY=

GATEWAY_TIMEOUT_CONNECT_SEC=30
GATEWAY_TIMEOUT_READ_SEC=300
GATEWAY_TIMEOUT_WRITE_SEC=300
GATEWAY_TIMEOUT_POOL_SEC=30
GATEWAY_HTTP_MAX_CONNECTIONS=200
GATEWAY_HTTP_MAX_KEEPALIVE_CONNECTIONS=100

# Prometheus and Loki keep their data in these host directories, normally on
# NFS, and run as GATEWAY_RUN_AS. 65534 (nobody) fits a root_squash NFS
# export: a directory root creates there is already owned by it. On a local
# disk, `chown 65534:65534` the directories instead. Both must exist: Compose
# does not create them.
GATEWAY_RUN_AS=65534:65534
GATEWAY_PROMETHEUS_VOLUME=/path/to/volume/for/prometheus
GATEWAY_LOKI_VOLUME=/path/to/volume/for/loki

# Scrapes both the gateway and the engine (vLLM /metrics at the address of
# GATEWAY_BACKEND_BASE_URL).
GATEWAY_PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
GATEWAY_PROMETHEUS_CONTAINER_NAME=embeddings-gateway-prometheus

GATEWAY_LOKI_IMAGE=grafana/loki:3.7.7
GATEWAY_LOKI_CONTAINER_NAME=embeddings-gateway-loki
GATEWAY_LOKI_APP_NAME=embeddings-gateway
GATEWAY_LOKI_ENABLED=true
GATEWAY_LOKI_PUSH_URL=http://embeddings-gateway-loki:3100/loki/api/v1/push
GATEWAY_LOKI_BATCH_SIZE=200
GATEWAY_LOKI_FLUSH_INTERVAL_SEC=1.0
GATEWAY_LOKI_QUEUE_MAX_SIZE=10000
